<launch>
  <!-- =====================================================================
       Aurora S visual-SLAM wrapper (project integration)
       =====================================================================
       Runs the SLAMTEC Aurora ROS node (pkg slamware_ros_sdk) with ALL of
       its coordinate frames renamed to aurora_* so its TF tree does NOT
       collide with the wheeltec robot tree, which already owns:
           map -> odom -> base_link
       The Aurora therefore runs as an INDEPENDENT visual-SLAM + perception
       source, publishing its own tree:
           aurora_map -> aurora_odom -> aurora_base_link -> aurora_camera_*

       Topics stay under /slamware_ros_sdk_server_node/ (namespaced), so
       they never clash with the robot's /odom, /map, /scan either.

       PREREQ (source the vendor workspace first):
           source ~/aurora_ros/devel/setup.bash
       RUN:
           roslaunch ~/Go_by_my_self/Detect/new_detect/aurora_slam.launch
       (with the robot up, ROS_MASTER_URI from ~/.bashrc = the robot; the
        Aurora node registers with it. No master override needed.)

       KEY DATA TO CONSUME DOWNSTREAM:
         /slamware_ros_sdk_server_node/robot_pose   6DOF visual pose (aurora_map)
         /slamware_ros_sdk_server_node/point_cloud  dense depth cloud
         /slamware_ros_sdk_server_node/depth_image_raw
         /slamware_ros_sdk_server_node/imu_raw_data
       (left_image_raw / right_image_raw / semantic_segmentation are OFF —
        see the no_preview_image note below.)
       ===================================================================== -->

  <arg name="ip_address" default="192.168.11.1" />

  <node pkg="slamware_ros_sdk" type="slamware_ros_sdk_server_node"
        name="slamware_ros_sdk_server_node" output="screen">
    <param name="ip_address"            value="$(arg ip_address)"/>
    <param name="angle_compensate"      value="true"/>

    <!-- renamed frames so the Aurora tree stays separate from wheeltec -->
    <param name="map_frame"             value="aurora_map"/>
    <param name="robot_frame"           value="aurora_base_link"/>
    <param name="odom_frame"            value="aurora_odom"/>
    <param name="laser_frame"           value="aurora_laser"/>
    <param name="imu_frame"             value="aurora_imu_link"/>
    <param name="camera_left"           value="aurora_camera_left"/>
    <param name="camera_right"          value="aurora_camera_right"/>

    <param name="robot_pose_pub_period" value="0.05"/>
    <param name="scan_pub_period"       value="0.1"/>
    <param name="map_pub_period"        value="0.2"/>
    <param name="imu_raw_data_period"   value="0.005"/>
    <param name="ladar_data_clockwise"  value="true"/>
    <param name="robot_pose_topic"      value="robot_pose"/>
    <!-- MUST stay true on the Jetson (aarch64). With the compressed preview
         stream ON (value="false", which is also the SDK default) the node
         SIGSEGVs ~1 s after "whole explore map synchronized" — reproduced
         3/3 on SDK 2.1.1-rtm / L4T R35.6.0, 2026-08-05. true => stable,
         robot_pose 14.7 Hz / point_cloud 10 Hz / odom 10 Hz / imu 212 Hz.
         Cost: left_image_raw, right_image_raw and semantic_segmentation stop
         publishing, so inspect_semantic_seg.py and `record_aurora.sh full`
         won't work. Nothing on the autopilot path uses them. -->
    <param name="no_preview_image"      value="true"/>
    <!-- raw (uncompressed) image stream off: needs >=300 Mbps if enabled -->
    <param name="raw_image_on"          value="false"/>
  </node>

  <!-- Aurora-internal static transforms (copied from the vendor launch,
       frames renamed to aurora_*). The node itself publishes the dynamic
       aurora_odom -> aurora_base_link edge (the live SLAM pose). -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="aurora_odom2map"
        args="0 0 0 0 0 0 1 aurora_map aurora_odom"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="aurora_leftcam2base"
        args="0.0418 0.03 0 -0.5 0.5 -0.5 0.5 aurora_base_link aurora_camera_left"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="aurora_rightcam2leftcam"
        args="0.06 0 0 0 0 0 1 aurora_camera_left aurora_camera_right"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="aurora_imu2leftcam"
        args="0.03 0 0 0 0 -0.7071068 0.7071068 aurora_camera_left aurora_imu_link"/>

  <!-- =====================================================================
       LATER (fusion only) — bridge Aurora data into the robot frame.
       Needed ONLY when you want the Aurora point cloud / obstacles expressed
       relative to the robot base (e.g. for navigation), not for running the
       Aurora on its own.

       NOTE: aurora_base_link already has a parent (aurora_odom, from the SLAM
       node); a TF frame can have only ONE parent, so you canNOT simply add
       base_link -> aurora_base_link. Fusing two SLAM trees is a design choice
       (shared world frame, or use /robot_pose as a measurement); ask first.

       Mount offset to measure when we get there (Aurora vs robot center):
         x = forward (m), y = left (m), z = up (m)
       ===================================================================== -->

</launch>
